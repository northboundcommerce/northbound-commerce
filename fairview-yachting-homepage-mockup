
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Fairview Yachting — Homepage Mockup</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --navy: #0A1628;
  --navy-mid: #162744;
  --navy-light: #1E3A5F;
  --gold: #C49A3C;
  --gold-light: #E8C97A;
  --cream: #F5F0E6;
  --cream-light: #FAF8F3;
  --white: #FFFFFF;
  --text-dark: #0A1628;
  --text-mid: #3D4F63;
  --text-muted: #7A8EA3;
  --border: rgba(196,154,60,0.2);
  --serif: 'Cormorant Garamond', Georgia, serif;
  --sans: 'Jost', system-ui, sans-serif;
}

html { scroll-behavior: smooth; }
body { font-family: var(--sans); color: var(--text-dark); background: var(--white); overflow-x: hidden; }

/* ── NAV ── */
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  padding: 0 48px;
  height: 72px;
  display: flex; align-items: center; justify-content: space-between;
  background: transparent;
  transition: background 0.4s ease, box-shadow 0.4s ease;
}
nav.scrolled {
  background: rgba(10,22,40,0.97);
  box-shadow: 0 1px 0 rgba(196,154,60,0.25);
}
.nav-logo {
  font-family: var(--serif);
  font-size: 22px;
  font-weight: 600;
  color: var(--white);
  letter-spacing: 0.04em;
  text-decoration: none;
  display: flex; align-items: center; gap: 10px;
}
.nav-logo-mark {
  width: 32px; height: 32px;
  border: 1.5px solid var(--gold);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.nav-logo-mark svg { width: 16px; height: 16px; fill: var(--gold); }
.nav-links {
  display: flex; gap: 36px; list-style: none;
}
.nav-links a {
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.85);
  text-decoration: none;
  transition: color 0.2s;
  position: relative;
}
.nav-links a::after {
  content: ''; position: absolute; bottom: -3px; left: 0; right: 0;
  height: 1px; background: var(--gold); transform: scaleX(0);
  transition: transform 0.2s ease;
}
.nav-links a:hover { color: var(--white); }
.nav-links a:hover::after { transform: scaleX(1); }
.nav-right { display: flex; align-items: center; gap: 20px; }
.nav-lang {
  font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
  color: rgba(255,255,255,0.6); cursor: pointer;
  display: flex; align-items: center; gap: 4px;
}
.nav-lang svg { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 1.5; }
.nav-cta {
  font-size: 12px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--white); border: 1px solid rgba(196,154,60,0.6);
  padding: 9px 20px; text-decoration: none;
  transition: background 0.2s, border-color 0.2s;
}
.nav-cta:hover { background: var(--gold); border-color: var(--gold); }

/* ── HERO ── */
.hero {
  height: 100vh; min-height: 700px;
  position: relative; display: flex; align-items: flex-end;
  background: linear-gradient(180deg, #0A1E35 0%, #0D2D4A 40%, #0E3D5C 70%, #143250 100%);
  overflow: hidden;
}
.hero-water {
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse 120% 60% at 50% 90%, rgba(14,100,140,0.5) 0%, transparent 70%),
    radial-gradient(ellipse 80% 40% at 20% 70%, rgba(10,60,100,0.4) 0%, transparent 60%),
    radial-gradient(ellipse 60% 50% at 80% 60%, rgba(8,45,80,0.5) 0%, transparent 65%);
}
.hero-horizon {
  position: absolute; bottom: 28%; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.06), rgba(196,154,60,0.15), rgba(255,255,255,0.06), transparent);
}
.hero-sun {
  position: absolute; bottom: 28%; left: 50%; transform: translateX(-50%);
  width: 120px; height: 60px;
  background: radial-gradient(ellipse at 50% 100%, rgba(220,170,60,0.35) 0%, transparent 70%);
}
.hero-yacht {
  position: absolute; bottom: 28%; right: 18%;
  width: 280px; height: 120px;
  opacity: 0.15;
}
.hero-yacht svg { width: 100%; height: 100%; }
.hero-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(0deg, rgba(10,22,40,0.75) 0%, rgba(10,22,40,0.2) 50%, rgba(10,22,40,0.4) 100%);
}
.hero-content {
  position: relative; z-index: 2;
  padding: 0 10% 100px;
  max-width: 760px;
}
.hero-eyebrow {
  font-size: 11px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--gold); margin-bottom: 20px;
  display: flex; align-items: center; gap: 12px;
}
.hero-eyebrow::before {
  content: ''; display: block; width: 32px; height: 1px; background: var(--gold);
}
.hero-title {
  font-family: var(--serif);
  font-size: clamp(48px, 7vw, 88px);
  font-weight: 300;
  line-height: 1.05;
  color: var(--white);
  margin-bottom: 24px;
  letter-spacing: -0.01em;
}
.hero-title em { font-style: italic; color: rgba(255,255,255,0.75); }
.hero-sub {
  font-size: 15px; font-weight: 300; color: rgba(255,255,255,0.65);
  line-height: 1.7; margin-bottom: 40px; max-width: 480px;
}
.hero-actions { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
.btn-primary {
  font-size: 12px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase;
  background: var(--gold); color: var(--navy); border: none;
  padding: 15px 32px; cursor: pointer; text-decoration: none;
  transition: background 0.2s;
  display: inline-block;
}
.btn-primary:hover { background: var(--gold-light); }
.btn-ghost {
  font-size: 12px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase;
  background: transparent; color: var(--white);
  border: 1px solid rgba(255,255,255,0.35);
  padding: 14px 32px; cursor: pointer; text-decoration: none;
  transition: border-color 0.2s, background 0.2s;
  display: inline-block;
}
.btn-ghost:hover { border-color: rgba(255,255,255,0.7); background: rgba(255,255,255,0.06); }
.hero-scroll {
  position: absolute; bottom: 36px; left: 50%; transform: translateX(-50%);
  z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 8px;
}
.hero-scroll span { font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(255,255,255,0.4); }
.scroll-line { width: 1px; height: 40px; background: linear-gradient(180deg, rgba(196,154,60,0.6), transparent); animation: scrollPulse 2s ease infinite; }
@keyframes scrollPulse { 0%,100%{opacity:.4; transform:scaleY(1)} 50%{opacity:1; transform:scaleY(1.2)} }

/* ── SEARCH BAR ── */
.search-bar {
  position: absolute; bottom: 0; left: 0; right: 0; z-index: 3;
  background: rgba(10,22,40,0.95);
  border-top: 1px solid rgba(196,154,60,0.2);
  padding: 20px 10%;
  display: flex; align-items: center; gap: 0;
}
.search-tab {
  font-size: 11px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase;
  color: rgba(255,255,255,0.45); padding: 10px 24px; cursor: pointer;
  border-bottom: 2px solid transparent; transition: color 0.2s, border-color 0.2s;
  white-space: nowrap;
}
.search-tab.active { color: var(--gold); border-bottom-color: var(--gold); }
.search-divider { width: 1px; height: 32px; background: rgba(255,255,255,0.1); margin: 0 24px; }
.search-field {
  display: flex; flex-direction: column; gap: 3px; flex: 1; min-width: 0;
}
.search-field label { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.35); }
.search-field select {
  background: transparent; border: none; outline: none;
  font-family: var(--sans); font-size: 14px; color: var(--white);
  cursor: pointer; -webkit-appearance: none; padding: 0;
  option { background: var(--navy); }
}
.search-btn {
  background: var(--gold); border: none; color: var(--navy);
  font-family: var(--sans); font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
  padding: 12px 28px; cursor: pointer; white-space: nowrap; transition: background 0.2s;
  margin-left: 24px;
}
.search-btn:hover { background: var(--gold-light); }

/* ── SECTION STRUCTURE ── */
section { padding: 100px 10%; }
.section-label {
  font-size: 10px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--gold); margin-bottom: 14px;
  display: flex; align-items: center; gap: 10px;
}
.section-label::before { content: ''; width: 24px; height: 1px; background: var(--gold); }
.section-title {
  font-family: var(--serif); font-size: clamp(34px, 4vw, 52px);
  font-weight: 300; line-height: 1.12; color: var(--text-dark);
  margin-bottom: 16px;
}
.section-title em { font-style: italic; color: var(--text-mid); }
.section-intro {
  font-size: 15px; font-weight: 300; color: var(--text-muted);
  line-height: 1.75; max-width: 560px;
}

/* ── SERVICES ── */
.services { background: var(--cream-light); padding: 100px 10% 0; }
.services-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 2px; margin-top: 56px;
}
.service-card {
  background: var(--white);
  padding: 52px 44px;
  position: relative; overflow: hidden;
  transition: background 0.3s;
  cursor: pointer;
  text-decoration: none; display: block;
}
.service-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
  background: var(--gold); transform: scaleX(0); transform-origin: left;
  transition: transform 0.3s ease;
}
.service-card:hover::before { transform: scaleX(1); }
.service-card:hover { background: var(--navy); }
.service-card:hover .service-num,
.service-card:hover .service-title,
.service-card:hover .service-desc,
.service-card:hover .service-link { color: rgba(255,255,255,0.85); }
.service-card:hover .service-title { color: var(--white); }
.service-card:hover .service-icon { border-color: rgba(196,154,60,0.4); }
.service-card:hover .service-icon svg { stroke: var(--gold); }
.service-icon {
  width: 52px; height: 52px; border: 1px solid rgba(196,154,60,0.25);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 36px; transition: border-color 0.3s;
}
.service-icon svg { width: 24px; height: 24px; stroke: var(--gold); fill: none; stroke-width: 1.2; }
.service-num {
  font-size: 11px; letter-spacing: 0.15em; color: var(--text-muted);
  margin-bottom: 10px; transition: color 0.3s;
}
.service-title {
  font-family: var(--serif); font-size: 26px; font-weight: 400; line-height: 1.2;
  color: var(--text-dark); margin-bottom: 16px; transition: color 0.3s;
}
.service-desc {
  font-size: 14px; font-weight: 300; line-height: 1.75; color: var(--text-muted);
  margin-bottom: 32px; transition: color 0.3s;
}
.service-link {
  font-size: 11px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--gold); display: flex; align-items: center; gap: 8px;
  text-decoration: none; transition: color 0.3s;
}
.service-link svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2; transition: transform 0.2s; }
.service-card:hover .service-link svg { transform: translateX(4px); }

/* ── FEATURED YACHTS ── */
.yachts { background: var(--white); }
.yachts-header {
  display: flex; align-items: flex-end; justify-content: space-between;
  margin-bottom: 48px;
}
.yachts-tabs {
  display: flex; gap: 0; border-bottom: 1px solid rgba(10,22,40,0.1); margin-bottom: 0;
}
.yacht-tab {
  font-size: 12px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
  padding: 10px 20px; cursor: pointer; color: var(--text-muted);
  border-bottom: 2px solid transparent; margin-bottom: -1px;
  transition: color 0.2s, border-color 0.2s;
}
.yacht-tab.active { color: var(--navy); border-bottom-color: var(--navy); }
.view-all {
  font-size: 12px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--gold); text-decoration: none; display: flex; align-items: center; gap: 6px;
}
.view-all svg { width: 12px; height: 12px; stroke: currentColor; fill: none; stroke-width: 2; }
.yachts-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }
.yacht-card { background: var(--cream-light); overflow: hidden; cursor: pointer; }
.yacht-img {
  height: 220px; overflow: hidden; position: relative;
}
.yacht-img-inner {
  height: 100%; width: 100%;
  transition: transform 0.5s ease;
}
.yacht-card:hover .yacht-img-inner { transform: scale(1.04); }
.yacht-card:hover .yacht-price-tag { background: var(--gold); color: var(--navy); }
.yacht-body { padding: 28px 28px 32px; }
.yacht-category {
  font-size: 10px; font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase;
  color: var(--gold); margin-bottom: 8px;
}
.yacht-name {
  font-family: var(--serif); font-size: 22px; font-weight: 400;
  color: var(--text-dark); margin-bottom: 6px; line-height: 1.2;
}
.yacht-model { font-size: 13px; color: var(--text-muted); margin-bottom: 20px; font-weight: 300; }
.yacht-specs {
  display: flex; gap: 20px; margin-bottom: 24px;
  border-top: 1px solid rgba(10,22,40,0.08); padding-top: 18px;
}
.yacht-spec { display: flex; flex-direction: column; gap: 3px; }
.yacht-spec-label { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); }
.yacht-spec-val { font-size: 14px; font-weight: 500; color: var(--text-dark); }
.yacht-footer { display: flex; align-items: center; justify-content: space-between; }
.yacht-price-tag {
  font-size: 11px; font-weight: 600; letter-spacing: 0.05em;
  background: rgba(196,154,60,0.12); color: var(--gold);
  padding: 6px 14px; transition: background 0.2s, color 0.2s;
}
.yacht-enquire {
  font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--text-dark); text-decoration: none; display: flex; align-items: center; gap: 6px;
  border-bottom: 1px solid transparent; transition: border-color 0.2s;
}
.yacht-enquire:hover { border-bottom-color: var(--navy); }
.yacht-enquire svg { width: 12px; height: 12px; stroke: currentColor; fill: none; stroke-width: 2; }

/* Yacht image placeholders */
.yi-1 { background: linear-gradient(135deg, #0D2D4A 0%, #1A4A6B 40%, #0E3D5C 100%); }
.yi-2 { background: linear-gradient(135deg, #162744 0%, #0A3050 50%, #1E4A70 100%); }
.yi-3 { background: linear-gradient(135deg, #0A2038 0%, #143058 50%, #1A3E62 100%); }
.yi-4 { background: linear-gradient(135deg, #1A3A5C 0%, #0D2840 50%, #2A4E70 100%); }
.yi-5 { background: linear-gradient(135deg, #0E2A44 0%, #1C3E60 50%, #0A1E32 100%); }
.yi-6 { background: linear-gradient(135deg, #122038 0%, #1A3254 50%, #0C1E32 100%); }
.yacht-img-svg { position: absolute; bottom: 16px; right: 16px; opacity: 0.18; }

/* ── DESTINATIONS ── */
.destinations { background: var(--navy); padding: 100px 10%; }
.destinations .section-label::before { background: var(--gold); }
.destinations .section-title { color: var(--white); }
.destinations .section-title em { color: rgba(255,255,255,0.5); }
.destinations .section-intro { color: rgba(255,255,255,0.5); }
.dest-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  grid-template-rows: 260px 260px;
  gap: 3px; margin-top: 56px;
}
.dest-card {
  position: relative; overflow: hidden; cursor: pointer;
  display: flex; align-items: flex-end;
}
.dest-card:first-child { grid-row: 1 / 3; }
.dest-bg {
  position: absolute; inset: 0;
  transition: transform 0.5s ease;
}
.dest-card:hover .dest-bg { transform: scale(1.05); }
.d1 { background: linear-gradient(160deg, #0D4060 0%, #0A2D45 40%, #062040 80%, #0A2A3D 100%); }
.d2 { background: linear-gradient(160deg, #1A3A6C 0%, #0E2850 60%, #081A3C 100%); }
.d3 { background: linear-gradient(160deg, #1E4060 0%, #102840 60%, #06182C 100%); }
.d4 { background: linear-gradient(160deg, #0A2A4A 0%, #0E3858 60%, #061830 100%); }
.d5 { background: linear-gradient(160deg, #162840 0%, #0E2038 60%, #061428 100%); }
.dest-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(0deg, rgba(10,22,40,0.8) 0%, rgba(10,22,40,0.1) 60%);
}
.dest-content { position: relative; z-index: 2; padding: 28px 32px; }
.dest-region {
  font-size: 10px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--gold); margin-bottom: 6px;
}
.dest-name {
  font-family: var(--serif); font-size: 24px; font-weight: 300; color: var(--white);
  margin-bottom: 4px;
}
.dest-card:first-child .dest-name { font-size: 38px; margin-bottom: 8px; }
.dest-count { font-size: 12px; color: rgba(255,255,255,0.45); }
.dest-watermark {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
  font-family: var(--serif); font-size: 100px; font-weight: 300; letter-spacing: -0.02em;
  color: rgba(255,255,255,0.04); white-space: nowrap; pointer-events: none;
}
.dest-card:first-child .dest-watermark { font-size: 160px; }

/* ── TRUST ── */
.trust { background: var(--cream-light); padding: 80px 10%; }
.trust-inner {
  display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center;
}
.trust-stats {
  display: grid; grid-template-columns: 1fr 1fr; gap: 2px;
}
.stat-box {
  background: var(--white); padding: 40px 36px;
  border-bottom: 2px solid var(--gold);
}
.stat-num {
  font-family: var(--serif); font-size: 52px; font-weight: 300;
  color: var(--navy); line-height: 1; margin-bottom: 8px;
}
.stat-num sup { font-size: 24px; vertical-align: super; }
.stat-label { font-size: 12px; font-weight: 400; color: var(--text-muted); letter-spacing: 0.05em; }
.trust-copy { }
.trust-copy .section-label { margin-bottom: 14px; }
.trust-copy .section-title { margin-bottom: 20px; }
.trust-body {
  font-size: 15px; font-weight: 300; line-height: 1.8; color: var(--text-mid);
  margin-bottom: 32px;
}
.trust-logos {
  display: flex; align-items: center; gap: 32px;
  border-top: 1px solid rgba(10,22,40,0.1); padding-top: 28px; margin-top: 28px;
}
.trust-logo-label { font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); white-space: nowrap; }
.brand-pill {
  font-family: var(--serif); font-size: 15px; font-weight: 600;
  color: var(--text-dark); padding: 7px 16px;
  border: 1px solid rgba(10,22,40,0.15);
  letter-spacing: 0.03em;
}

/* ── TESTIMONIALS ── */
.testimonials { background: var(--white); padding: 100px 10%; }
.testi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; margin-top: 56px; }
.testi-card {
  background: var(--cream-light); padding: 44px 40px;
  border-top: 2px solid transparent;
  transition: border-color 0.3s;
  position: relative;
}
.testi-card:hover { border-top-color: var(--gold); }
.testi-quote-mark {
  font-family: var(--serif); font-size: 72px; color: rgba(196,154,60,0.2);
  line-height: 0.6; margin-bottom: 20px; display: block;
}
.testi-text {
  font-family: var(--serif); font-size: 17px; font-style: italic; font-weight: 300;
  line-height: 1.7; color: var(--text-mid); margin-bottom: 28px;
}
.testi-author { font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dark); }
.testi-detail { font-size: 12px; color: var(--text-muted); margin-top: 3px; }
.testi-stars { display: flex; gap: 3px; margin-bottom: 20px; }
.testi-star { width: 12px; height: 12px; fill: var(--gold); }

/* ── BLOG ── */
.blog { background: var(--cream-light); padding: 100px 10%; }
.blog-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 2px; margin-top: 48px; }
.blog-card { background: var(--white); overflow: hidden; cursor: pointer; }
.blog-img { height: 200px; overflow: hidden; }
.blog-img-inner { height: 100%; width: 100%; transition: transform 0.5s; }
.blog-card:hover .blog-img-inner { transform: scale(1.04); }
.b1 { background: linear-gradient(135deg, #1A4060 0%, #0E2A44 100%); }
.b2 { background: linear-gradient(135deg, #0A2038 0%, #1A3A5C 100%); }
.b3 { background: linear-gradient(135deg, #102A48 0%, #0A1E34 100%); }
.blog-body { padding: 28px; }
.blog-tag {
  font-size: 10px; font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase;
  color: var(--gold); margin-bottom: 10px;
}
.blog-title {
  font-family: var(--serif); font-size: 19px; font-weight: 400;
  color: var(--text-dark); line-height: 1.3; margin-bottom: 10px;
}

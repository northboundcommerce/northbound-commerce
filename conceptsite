/* ============================================================
   SCENE.JS
   Three.js + WebGL layer. All geometry is built procedurally
   from primitives (no external GLTF dependency, so the scene
   always loads) — standing in for the Blender/Spline exports:
   a floating Aesop bottle duet (the hero "relic"), a sneaker,
   a skateboard, and a shopping bag, all drifting with gentle
   physics-inspired motion through painted gallery rooms.
   ============================================================ */

(function () {
  const canvas = document.getElementById('three-canvas');
  const scene = new THREE.Scene();
  scene.fog = new THREE.FogExp2(0x0e0b07, 0.045);

  const camera = new THREE.PerspectiveCamera(42, window.innerWidth / window.innerHeight, 0.1, 100);
  camera.position.set(0, 0, 9);

  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.outputColorSpace = THREE.SRGBColorSpace;
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 1.15;

  /* ---------------- lighting ---------------- */
  const keyLight = new THREE.PointLight(0xffe3b0, 18, 30, 2);
  keyLight.position.set(3, 4, 6);
  scene.add(keyLight);

  const rimLight = new THREE.PointLight(0xe8855a, 8, 25, 2);
  rimLight.position.set(-4, -2, 3);
  scene.add(rimLight);

  const fillLight = new THREE.AmbientLight(0x6b5a3e, 0.55);
  scene.add(fillLight);

  const goldSpot = new THREE.SpotLight(0xc9a86a, 12, 20, Math.PI / 6, 0.6, 1.5);
  goldSpot.position.set(0, 8, 4);
  goldSpot.target.position.set(0, 0, 0);
  scene.add(goldSpot, goldSpot.target);

  /* ---------------- materials ---------------- */
  const amberGlass = new THREE.MeshPhysicalMaterial({
    color: 0x9a5a28,
    metalness: 0.1,
    roughness: 0.15,
    transmission: 0.55,
    thickness: 1.4,
    ior: 1.45,
    clearcoat: 1,
    clearcoatRoughness: 0.1,
    envMapIntensity: 1.2
  });
  const capMaterial = new THREE.MeshStandardMaterial({ color: 0x1a1612, metalness: 0.6, roughness: 0.35 });
  const goldMaterial = new THREE.MeshStandardMaterial({ color: 0xc9a86a, metalness: 0.85, roughness: 0.25 });
  const canvasFabric = new THREE.MeshStandardMaterial({ color: 0xe6dabf, metalness: 0.0, roughness: 0.85 });
  const soleRubber = new THREE.MeshStandardMaterial({ color: 0x2a2018, metalness: 0.05, roughness: 0.7 });
  const coralAccent = new THREE.MeshStandardMaterial({ color: 0xe8855a, metalness: 0.2, roughness: 0.4 });
  const deckWood = new THREE.MeshStandardMaterial({ color: 0x5b3d22, metalness: 0.05, roughness: 0.55 });
  const olivePrint = new THREE.MeshStandardMaterial({ color: 0x6f7d4f, metalness: 0.1, roughness: 0.6 });
  const paperBag = new THREE.MeshStandardMaterial({ color: 0xd8c9a3, metalness: 0.0, roughness: 0.9, side: THREE.DoubleSide });

  /* ---------------- group: floating object factory ---------------- */
  const floaters = []; // {group, baseY, baseRotSpeed, driftSeed}

  function addFloater(group, opts) {
    group.userData.baseY = group.position.y;
    group.userData.driftSeed = Math.random() * Math.PI * 2;
    group.userData.bobAmp = opts.bobAmp || 0.18;
    group.userData.bobSpeed = opts.bobSpeed || 0.6;
    group.userData.rotSpeed = opts.rotSpeed || new THREE.Vector3(0.05, 0.08, 0.02);
    group.userData.parallax = opts.parallax || 1;
    scene.add(group);
    floaters.push(group);
    return group;
  }

  /* ----- the Aesop bottle duet (hero relic, stays center stage) ----- */
  function buildBottle(scale, colorTint) {
    const g = new THREE.Group();
    const bodyMat = amberGlass.clone();
    if (colorTint) bodyMat.color.set(colorTint);

    const body = new THREE.Mesh(new THREE.CylinderGeometry(0.62, 0.7, 2.5, 32), bodyMat);
    body.position.y = 0;
    g.add(body);

    const shoulder = new THREE.Mesh(new THREE.CylinderGeometry(0.32, 0.62, 0.45, 32), bodyMat);
    shoulder.position.y = 1.45;
    g.add(shoulder);

    const neck = new THREE.Mesh(new THREE.CylinderGeometry(0.28, 0.32, 0.5, 24), bodyMat);
    neck.position.y = 1.9;
    g.add(neck);

    const pumpBase = new THREE.Mesh(new THREE.CylinderGeometry(0.34, 0.3, 0.22, 24), capMaterial);
    pumpBase.position.y = 2.22;
    g.add(pumpBase);

    const pumpStem = new THREE.Mesh(new THREE.CylinderGeometry(0.045, 0.045, 0.55, 12), capMaterial);
    pumpStem.position.y = 2.55;
    g.add(pumpStem);

    const pumpHead = new THREE.Mesh(new THREE.CylinderGeometry(0.1, 0.1, 0.16, 16), capMaterial);
    pumpHead.position.set(0.18, 2.84, 0);
    pumpHead.rotation.z = Math.PI / 2.4;
    g.add(pumpHead);

    // gold label band
    const label = new THREE.Mesh(new THREE.CylinderGeometry(0.645, 0.645, 0.62, 32), new THREE.MeshStandardMaterial({ color: 0xece2c8, metalness: 0.0, roughness: 0.7 }));
    label.position.y = 0.1;
    g.add(label);
    const labelLine1 = new THREE.Mesh(new THREE.RingGeometry(0.643, 0.648, 32), goldMaterial);
    labelLine1.position.y = 0.32;
    labelLine1.rotation.x = Math.PI / 2;
    g.add(labelLine1);
    const labelLine2 = labelLine1.clone();
    labelLine2.position.y = -0.12;
    g.add(labelLine2);

    g.scale.setScalar(scale);
    return g;
  }

  const bottleDuet = new THREE.Group();
  const bottleA = buildBottle(0.62, 0x9a5a28); // cleanser
  bottleA.position.x = -0.55;
  const bottleB = buildBottle(0.62, 0xb97a42); // balm, slightly lighter
  bottleB.position.x = 0.55;
  bottleB.position.z = -0.3;
  bottleDuet.add(bottleA, bottleB);
  bottleDuet.position.set(0, -0.2, 0);
  addFloater(bottleDuet, { bobAmp: 0.12, bobSpeed: 0.4, rotSpeed: new THREE.Vector3(0, 0.12, 0), parallax: 0.3 });

  /* ----- procedural sneaker ----- */
  function buildSneaker() {
    const g = new THREE.Group();
    const sole = new THREE.Mesh(new THREE.CapsuleGeometry(0.32, 1.1, 6, 12), soleRubber);
    sole.rotation.z = Math.PI / 2;
    sole.scale.set(1, 0.5, 0.85);
    g.add(sole);

    const upper = new THREE.Mesh(new THREE.CapsuleGeometry(0.34, 0.85, 6, 12), canvasFabric);
    upper.rotation.z = Math.PI / 2;
    upper.scale.set(0.95, 0.62, 0.78);
    upper.position.set(-0.05, 0.22, 0);
    g.add(upper);

    const tongue = new THREE.Mesh(new THREE.BoxGeometry(0.28, 0.32, 0.06), coralAccent);
    tongue.position.set(0.25, 0.45, 0);
    tongue.rotation.z = -0.3;
    g.add(tongue);

    for (let i = 0; i < 4; i++) {
      const lace = new THREE.Mesh(new THREE.TorusGeometry(0.16, 0.012, 6, 12, Math.PI), goldMaterial);
      lace.position.set(0.1 - i * 0.13, 0.5, 0);
      lace.rotation.z = Math.PI;
      g.add(lace);
    }

    const heelTab = new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.22, 0.3), olivePrint);
    heelTab.position.set(-0.62, 0.28, 0);
    g.add(heelTab);

    g.scale.setScalar(1.05);
    return g;
  }
  const sneaker = addFloater(buildSneaker(), { bobAmp: 0.28, bobSpeed: 0.5, rotSpeed: new THREE.Vector3(0.1, 0.2, 0.05), parallax: 1.3 });
  sneaker.position.set(-3.6, 1.6, -1.5);

  /* ----- procedural skateboard ----- */
  function buildSkateboard() {
    const g = new THREE.Group();
    const deckShape = new THREE.Shape();
    deckShape.moveTo(-1.1, -0.18);
    deckShape.quadraticCurveTo(-1.25, 0, -1.1, 0.18);
    deckShape.lineTo(1.1, 0.18);
    deckShape.quadraticCurveTo(1.25, 0, 1.1, -0.18);
    deckShape.closePath();
    const deckGeo = new THREE.ExtrudeGeometry(deckShape, { depth: 0.06, bevelEnabled: true, bevelThickness: 0.02, bevelSize: 0.02, bevelSegments: 3 });
    deckGeo.rotateX(Math.PI / 2);
    const deck = new THREE.Mesh(deckGeo, deckWood);
    g.add(deck);

    const stripeGeo = new THREE.PlaneGeometry(1.9, 0.12);
    const stripe = new THREE.Mesh(stripeGeo, olivePrint);
    stripe.rotation.x = -Math.PI / 2;
    stripe.position.y = 0.035;
    g.add(stripe);

    [-0.75, 0.75].forEach(x => {
      const truck = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.08, 0.1), capMaterial);
      truck.position.set(x, -0.07, 0);
      g.add(truck);
      [-0.32, 0.32].forEach(z => {
        const wheel = new THREE.Mesh(new THREE.CylinderGeometry(0.13, 0.13, 0.08, 16), coralAccent);
        wheel.rotation.x = Math.PI / 2;
        wheel.position.set(x, -0.15, z);
        g.add(wheel);
      });
    });

    return g;
  }
  const skateboard = addFloater(buildSkateboard(), { bobAmp: 0.22, bobSpeed: 0.45, rotSpeed: new THREE.Vector3(0.04, 0.06, 0.15), parallax: 1.1 });
  skateboard.position.set(3.4, -1.3, -2);
  skateboard.rotation.set(0.4, 0.6, 0.2);
  skateboard.scale.setScalar(1.3);

  /* ----- procedural shopping bag ----- */
  function buildShoppingBag() {
    const g = new THREE.Group();
    const body = new THREE.Mesh(new THREE.BoxGeometry(0.9, 1.1, 0.45), paperBag);
    g.add(body);

    const goldSeam = new THREE.Mesh(new THREE.BoxGeometry(0.92, 0.02, 0.47), goldMaterial);
    goldSeam.position.y = 0.3;
    g.add(goldSeam);

    const handleGeo = new THREE.TorusGeometry(0.32, 0.025, 8, 24, Math.PI);
    [-0.28, 0.28].forEach(x => {
      const handle = new THREE.Mesh(handleGeo, capMaterial);
      handle.position.set(x, 0.78, 0);
      handle.rotation.z = Math.PI;
      g.add(handle);
    });

    return g;
  }
  const shoppingBag = addFloater(buildShoppingBag(), { bobAmp: 0.2, bobSpeed: 0.55, rotSpeed: new THREE.Vector3(0.03, 0.1, 0.02), parallax: 0.9 });
  shoppingBag.position.set(-3.2, -1.8, -3);
  shoppingBag.rotation.set(0.1, 0.5, -0.1);

  /* ----- a single geranium leaf, abstracted (torn-paper silhouette) ----- */
  function buildLeaf() {
    const shape = new THREE.Shape();
    shape.moveTo(0, 0.6);
    shape.bezierCurveTo(0.45, 0.5, 0.55, -0.1, 0, -0.7);
    shape.bezierCurveTo(-0.55, -0.1, -0.45, 0.5, 0, 0.6);
    const geo = new THREE.ExtrudeGeometry(shape, { depth: 0.02, bevelEnabled: false });
    const leaf = new THREE.Mesh(geo, olivePrint);
    return leaf;
  }
  const leaf1 = addFloater(buildLeaf(), { bobAmp: 0.3, bobSpeed: 0.8, rotSpeed: new THREE.Vector3(0.2, 0.3, 0.1), parallax: 1.6 });
  leaf1.position.set(2.2, 2.1, -1);
  leaf1.scale.setScalar(0.8);
  const leaf2 = addFloater(buildLeaf(), { bobAmp: 0.26, bobSpeed: 0.7, rotSpeed: new THREE.Vector3(-0.15, 0.25, -0.1), parallax: 1.4 });
  leaf2.position.set(-2.6, 2.4, -2.5);
  leaf2.scale.setScalar(0.6);
  leaf2.rotation.z = 1.2;

  /* ---------------- ambient particles (dust / pollen motes) ---------------- */
  const particleCount = 260;
  const particleGeo = new THREE.BufferGeometry();
  const positions = new Float32Array(particleCount * 3);
  const speeds = new Float32Array(particleCount);
  for (let i = 0; i < particleCount; i++) {
    positions[i * 3] = (Math.random() - 0.5) * 16;
    positions[i * 3 + 1] = (Math.random() - 0.5) * 12;
    positions[i * 3 + 2] = (Math.random() - 0.5) * 10 - 2;
    speeds[i] = 0.15 + Math.random() * 0.35;
  }
  particleGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  const particleMat = new THREE.PointsMaterial({
    color: 0xc9a86a,
    size: 0.035,
    transparent: true,
    opacity: 0.55,
    sizeAttenuation: true,
    blending: THREE.AdditiveBlending,
    depthWrite: false
  });
  const particles = new THREE.Points(particleGeo, particleMat);
  scene.add(particles);

  /* ---------------- glow sprite behind bottle (bloom stand-in) ---------------- */
  function makeGlowTexture() {
    const size = 256;
    const c = document.createElement('canvas');
    c.width = c.height = size;
    const cx = c.getContext('2d');
    const grad = cx.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
    grad.addColorStop(0, 'rgba(255,230,180,0.9)');
    grad.addColorStop(0.4, 'rgba(201,168,106,0.35)');
    grad.addColorStop(1, 'rgba(201,168,106,0)');
    cx.fillStyle = grad;
    cx.fillRect(0, 0, size, size);
    return new THREE.CanvasTexture(c);
  }
  const glowSprite = new THREE.Sprite(new THREE.SpriteMaterial({
    map: makeGlowTexture(),
    transparent: true,
    blending: THREE.AdditiveBlending,
    depthWrite: false
  }));
  glowSprite.scale.set(7, 7, 1);
  glowSprite.position.set(0, 0.4, -1.5);
  scene.add(glowSprite);

  /* ---------------- mouse parallax ---------------- */
  let targetMouseX = 0, targetMouseY = 0;
  let mouseX = 0, mouseY = 0;
  window.addEventListener('mousemove', (e) => {
    targetMouseX = (e.clientX / window.innerWidth - 0.5) * 2;
    targetMouseY = (e.clientY / window.innerHeight - 0.5) * 2;
    if (window.PaintingEngine) window.PaintingEngine.setMouse(e.clientX / window.innerWidth, e.clientY / window.innerHeight);
  });

  /* ---------------- scroll-driven camera state, set by main.js ---------------- */
  let scrollProgress = 0; // 0..1
  let scrollVelocity = 0;
  function setScrollProgress(p, vel) {
    scrollProgress = p;
    scrollVelocity = vel || 0;
  }

  /* camera path: drifts through "rooms" as user scrolls */
  const cameraPath = [
    { z: 9, y: 0, x: 0, fov: 42 },        // hero
    { z: 7.5, y: 0.4, x: -1.2, fov: 40 }, // room1
    { z: 6.5, y: -0.2, x: 1.4, fov: 44 }, // room2
    { z: 7, y: 0.6, x: 0, fov: 38 },      // room3
    { z: 8.5, y: 0, x: 0, fov: 36 },      // ritual
    { z: 6, y: 0, x: 0, fov: 46 },        // contrast
    { z: 9.5, y: 0.1, x: 0, fov: 40 }     // finale
  ];

  function getCameraStateAt(p) {
    const n = cameraPath.length - 1;
    const idx = Math.min(n - 1, Math.floor(p * n));
    const localT = p * n - idx;
    const A = cameraPath[idx], B = cameraPath[Math.min(n, idx + 1)];
    const ease = localT * localT * (3 - 2 * localT); // smoothstep
    return {
      x: A.x + (B.x - A.x) * ease,
      y: A.y + (B.y - A.y) * ease,
      z: A.z + (B.z - A.z) * ease,
      fov: A.fov + (B.fov - A.fov) * ease
    };
  }

  /* ---------------- render loop ---------------- */
  const clockObj = new THREE.Clock();

  function animate() {
    const t = clockObj.getElapsedTime();

    mouseX += (targetMouseX - mouseX) * 0.04;
    mouseY += (targetMouseY - mouseY) * 0.04;

    // camera
    const camState = getCameraStateAt(scrollProgress);
    camera.position.x += (camState.x + mouseX * 0.4 - camera.position.x) * 0.06;
    camera.position.y += (camState.y - mouseY * 0.3 - camera.position.y) * 0.06;
    camera.position.z += (camState.z - camera.position.z) * 0.06;
    camera.fov += (camState.fov - camera.fov) * 0.05;
    camera.updateProjectionMatrix();
    camera.lookAt(0, 0, 0);

    // floaters: bob + rotate + drift tied to scroll velocity
    floaters.forEach((f) => {
      const ud = f.userData;
      f.position.y = ud.baseY + Math.sin(t * ud.bobSpeed + ud.driftSeed) * ud.bobAmp;
      f.rotation.x += ud.rotSpeed.x * 0.01;
      f.rotation.y += ud.rotSpeed.y * 0.01 + scrollVelocity * 0.02 * ud.parallax;
      f.rotation.z += ud.rotSpeed.z * 0.01;
    });

    // bottle duet glow follows the relic
    glowSprite.position.copy(bottleDuet.position);
    glowSprite.position.y += 0.4;

    // particles drift upward slowly like motes in gallery light
    const posAttr = particleGeo.attributes.position;
    for (let i = 0; i < particleCount; i++) {
      let y = posAttr.array[i * 3 + 1];
      y += speeds[i] * 0.0035;
      if (y > 6) y = -6;
      posAttr.array[i * 3 + 1] = y;
    }
    posAttr.needsUpdate = true;
    particles.rotation.y = t * 0.01;

    keyLight.intensity = 16 + Math.sin(t * 0.6) * 2;

    renderer.render(scene, camera);
    requestAnimationFrame(animate);
  }
  animate();

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });

  window.SceneEngine = {
    setScrollProgress,
    bottleDuet, sneaker, skateboard, shoppingBag, leaf1, leaf2,
    camera
  };
})();
